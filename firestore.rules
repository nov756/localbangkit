rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'nadin8258@gmail.com';
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 128;
    }

    function isValidUmkm(data) {
      return data.keys().hasAll(['id', 'name', 'category', 'description', 'location', 'whatsapp'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.category is string && data.category in ['kuliner', 'jasa', 'kerajinan', 'sembako']
        && data.description is string && data.description.size() <= 1000
        && data.location is string && data.location.size() <= 200
        && data.whatsapp is string && data.whatsapp.size() >= 10 && data.whatsapp.size() <= 20;
    }

    function isValidPledge(data) {
      return data.keys().hasAll(['id', 'userId', 'monthlySpend'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.monthlySpend is number && data.monthlySpend > 0 && data.monthlySpend <= 100000000;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: owner only or admin
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming());
      allow delete: if isAdmin();
    }

    // Public community UMKM directory
    match /umkm/{umkmId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(umkmId)
        && isValidUmkm(incoming())
        && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn()
        && isValidId(umkmId)
        && isValidUmkm(incoming())
        && (existing().authorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && isValidId(umkmId)
        && (existing().authorId == request.auth.uid || isAdmin());
    }

    // Community economic pledges
    match /pledges/{pledgeId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidId(pledgeId)
        && isValidPledge(incoming())
        && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn()
        && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
